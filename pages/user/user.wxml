<!-- pages/user/user.wxml -->
<view class="page-container">
  <!-- 用户信息卡片 -->
  <view class="card-container user-info-card">
    <view class="user-avatar" bindtap="onTapUserInfo">
      <image src="{{hasUserInfo && userInfo.avatarUrl ? userInfo.avatarUrl : staticImages.defaultAvatar}}" mode="aspectFit"></image>
    </view>
    <view class="user-detail" bindtap="onTapUserInfo">
      <view class="user-name">{{hasUserInfo && userInfo.nickName ? userInfo.nickName : '点击登陆'}}</view>
      <view class="user-desc">{{hasUserInfo ? '开始你的考研之旅吧！' : '登录后同步学习数据'}}</view>
    </view>
    <view class="user-action-area">
      <view class="action-btn" bindtap="editUserInfo">
        <text>编辑资料</text>
      </view>
      <view class="action-btn" bindtap="logout" wx:if="{{hasUserInfo}}">
        <text>退出登录</text>
      </view>
    </view>
  </view>

  <!-- 学习统计 -->
  <view class="card-container">
    <view class="section-title">学习统计</view>
    <view class="stats-grid">
      <view class="stat-item">
        <view class="stat-value">{{hasUserInfo ? totalQuestions : '--'}}</view>
        <view class="stat-label">总题数</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{hasUserInfo ? correctQuestions : '--'}}</view>
        <view class="stat-label">答对题数</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{hasUserInfo ? accuracy + '%' : '--'}}</view>
        <view class="stat-label">正确率</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{hasUserInfo ? studyDays : '--'}}</view>
        <view class="stat-label">学习天数</view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="card-container">
    <view class="menu-item" bindtap="navigateToCollection">
      <view class="menu-left">
        <view class="menu-icon">❤️</view>
        <view class="menu-text">我的收藏</view>
      </view>
      <view class="menu-right">
        <text class="menu-arrow">→</text>
      </view>
    </view>
    <view class="menu-item" bindtap="navigateToWrong">
      <view class="menu-left">
        <view class="menu-icon">❌</view>
        <view class="menu-text">我的错题</view>
      </view>
      <view class="menu-right">
        <text class="menu-arrow">→</text>
      </view>
    </view>
    <view class="menu-item" bindtap="navigateToStudyPlan">
      <view class="menu-left">
        <view class="menu-icon">📅</view>
        <view class="menu-text">学习计划</view>
      </view>
      <view class="menu-right">
        <text class="menu-arrow">→</text>
      </view>
    </view>
    <view class="menu-item" bindtap="navigateToSettings">
      <view class="menu-left">
        <view class="menu-icon">⚙️</view>
        <view class="menu-text">设置</view>
      </view>
      <view class="menu-right">
        <text class="menu-arrow">→</text>
      </view>
    </view>
  </view>

  <!-- 关于我们 -->
  <view class="card-container">
    <view class="menu-item" bindtap="navigateToAbout">
      <view class="menu-left">
        <view class="menu-icon">ℹ️</view>
        <view class="menu-text">关于我们</view>
      </view>
      <view class="menu-right">
        <text class="menu-arrow">→</text>
      </view>
    </view>
  </view>

  <!-- 开发者工具 -->
  <view class="card-container">
    <view class="menu-item" bindtap="importQuestions">
      <view class="menu-left">
        <view class="menu-icon">📤</view>
        <view class="menu-text">导入题库数据(开发专用)</view>
      </view>
      <view class="menu-right">
        <text class="menu-arrow">→</text>
      </view>
    </view>
  </view>

  <!-- 登录/完善资料弹窗 -->
  <view class="login-modal" wx:if="{{showLoginModal}}">
    <view class="modal-mask" bindtap="closeLoginModal"></view>
    <view class="modal-content">
      <view class="modal-header">完善个人信息</view>
      <view class="modal-body">
        <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image class="avatar-preview" src="{{tempAvatarUrl || staticImages.defaultAvatar}}"></image>
        </button>
        <view class="avatar-tip">点击修改头像</view>
        <view class="input-group">
          <text class="label">昵称</text>
          <input type="nickname" class="nickname-input" placeholder="请输入昵称" bind:change="onNicknameChange" bindinput="onNicknameInput" value="{{tempNickName}}"/>
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeLoginModal">取消</button>
        <button class="btn-confirm" bindtap="submitUserInfo">确定</button>
      </view>
    </view>
  </view>
</view>