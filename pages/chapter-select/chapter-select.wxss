/* pages/chapter-select/chapter-select.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f7f8fa;
}

.header {
  padding: 30rpx 40rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.subject-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

.filter-container {
  background-color: #fff;
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.filter-item {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.filter-item:last-child {
  margin-bottom: 0;
}

.filter-label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-right: 24rpx;
  min-width: 70rpx;
}

.picker-container {
  flex: 1;
  display: block;
  background-color: #f5f7fa;
  border-radius: 12rpx;
  padding: 24rpx;
  box-sizing: border-box;
  transition: all 0.3s;
}

.picker-container:active {
  background-color: #edf0f5;
}

.picker-content {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  pointer-events: none; /* 关键：让点击事件穿透到 picker 组件 */
}

.picker-content.empty {
  color: #999;
}

.picker-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 20rpx;
}

.arrow {
  color: #c0c4cc;
  font-size: 24rpx;
}

.question-list {
  flex: 1;
  overflow: hidden;
  background-color: #fff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  margin-top: 0;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.03);
}

/* 章节列表样式 */
.chapter-item {
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chapter-item:active {
  background-color: #fafafa;
}

.chapter-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-right: 20rpx;
}

.chapter-name {
  font-size: 30rpx;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
}

.chapter-progress {
  font-size: 26rpx;
  color: #666;
  background-color: #f0f2f5;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.chapter-progress.completed {
  background-color: #e8f5e9;
  color: #27ae60;
}

.chapter-progress.in-progress {
  background-color: #e1f5fe;
  color: #2980b9;
}

.chapter-arrow {
  color: #ccc;
  font-size: 32rpx;
}

/* 题目列表样式 */
.question-item {
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  display: flex;
  align-items: flex-start;
}

.question-item:active {
  background-color: #fafafa;
}

.question-no {
  font-size: 28rpx;
  color: #999;
  margin-right: 16rpx;
  min-width: 44rpx;
  padding-top: 2rpx;
}

.question-content {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.question-type {
  font-size: 22rpx;
  color: #3498db;
  background-color: rgba(52, 152, 219, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 20rpx;
  align-self: flex-start;
  white-space: nowrap;
}

.loading-state, .empty-state, .no-more-state {
  padding: 40rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.footer {
  padding: 24rpx 32rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
}

.btn-secondary {
  background-color: #f5f7fa;
  color: #666;
}

.btn-secondary:active {
  background-color: #edf0f5;
}

.btn-primary {
  background-color: #3498db;
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(52, 152, 219, 0.3);
}

.btn-primary:active {
  background-color: #2980b9;
}