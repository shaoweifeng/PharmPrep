/* pages/chapter-select/chapter-select.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.header {
  padding: 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.subject-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
}

.filter-container {
  background-color: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.filter-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-item:last-child {
  margin-bottom: 0;
  border-bottom: none;
}

.filter-label {
  width: 100rpx;
  font-size: 28rpx;
  color: #666;
}

.picker {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.arrow {
  color: #999;
  font-size: 24rpx;
}

.question-list {
  flex: 1;
  overflow: hidden;
  background-color: #fff;
}

.question-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  align-items: flex-start;
}

.question-item:active {
  background-color: #fafafa;
}

.question-no {
  font-size: 28rpx;
  color: #999;
  margin-right: 10rpx;
  min-width: 40rpx;
}

.question-content {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.question-type {
  font-size: 24rpx;
  color: #3498db;
  background-color: #e8f4fc;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-left: 20rpx;
}

.loading-state, .empty-state, .no-more-state {
  padding: 30rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.footer {
  padding: 20rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.btn {
  flex: 1;
  font-size: 32rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
}

.btn-secondary {
  background-color: #f5f5f5;
  color: #666;
}

.btn-primary {
  background-color: #3498db;
  color: #fff;
}
