<!-- pages/essay/essay.wxml -->
<view class="page-container">
  <view class="card-container">
    <view class="section-title">大题带背</view>
    <view class="subject-tabs">
      <view class="tab-item {{activeTab === item.id ? 'active' : ''}}" wx:for="{{subjectList}}" wx:key="id" bindtap="switchTab" data-tab-id="{{item.id}}">
        {{item.name}}
      </view>
    </view>
  </view>

  <view class="card-container">
    <view class="essay-header">
      <view class="essay-count">共{{essayList.length}}道题</view>
      <view class="essay-filter">
        <picker bindchange="bindPickerChange" value="{{pickerIndex}}" range="{{filterOptions}}">
          <view class="filter-btn">
            {{filterOptions[pickerIndex]}}
            <view class="filter-arrow">▼</view>
          </view>
        </picker>
      </view>
    </view>
    
    <view class="essay-list">
      <view class="essay-item" wx:for="{{filteredEssayList}}" wx:key="id" bindtap="showEssayDetail" data-essay-id="{{item.id}}">
        <view class="essay-number">{{item.number}}.</view>
        <view class="essay-content">
          <view class="essay-question">{{item.question}}</view>
          <view class="essay-tags">
            <view class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="tag">{{tag}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>